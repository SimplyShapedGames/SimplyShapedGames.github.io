---
import SiteLayout from '../layouts/SiteLayout.astro';
import Catalogue from '../components/Catalogue.astro';
import { categories } from '../lib/catalogue';
export function getStaticPaths() { return categories.filter(c => c.id !== 'all').map(category => ({ params: { category: category.id }, props: { category } })); }
const { category } = Astro.props;
---
<SiteLayout title={category.title} active="work" description={category.id === 'games' ? 'Play ShapeDash, PiecePerfect and Slide, independent Android games by SimplyShapedGames.' : 'Explore Minecraft and Left 4 Dead 2 mods by SimplyShapedGames.'}><Catalogue category={category.id} standalone /></SiteLayout>
