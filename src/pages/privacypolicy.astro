---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getEntry, render } from 'astro:content';
const policy = await getEntry('pages', 'privacypolicy');
if (!policy) throw new Error('The original privacy policy is missing.');
const { Content } = await render(policy);
---
<SiteLayout title="Privacy Policy" active="privacy" description="SimplyShapedGames privacy policy and data deletion contact."><article class="page-shell policy-page"><header class="page-heading"><p class="eyebrow">SimplyShapedGames</p><h1>Privacy policy<span class="blue-text">.</span></h1></header><div class="prose policy-content"><Content /></div></article></SiteLayout>
