---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Discuss your game or mod project" active="contact" description="Tell Storm Eckhart about your game, mod or existing-project needs. Discuss the scope, platforms, priorities and budget for a tailored development quote.">
  <div class="service-container brief-page">
    <header class="service-page-heading"><h1>Tell me what you want to make.</h1><p>A clear starting point is enough. We can work out the scope together.</p></header>
    <div class="brief-layout">
      <div class="brief-introduction"><h2>Let's start with a conversation.</h2><p>Send a short description of your idea, or use the brief below to prepare an email. A quote depends on the work involved, the platforms and your priorities.</p><a class="service-text-link contact-address" href="mailto:stormeckhart@simplyshapedgames.fr">stormeckhart@simplyshapedgames.fr</a><h3>Need help with a released project?</h3><p>Include the game or mod name, your device or platform, and what happened. Screenshots or steps to reproduce the issue help.</p><a class="service-text-link" href="/privacypolicy/#request-user-data-deletion">Privacy &amp; data deletion requests</a><h3>Looking for a website?</h3><p>Visit <a class="inline-link" href="https://simplyshapedsites.fr/">SimplyShapedSites</a> for web development, or <a class="inline-link" href="https://simplyshaped.fr/">SimplyShaped</a> for my full portfolio.</p></div>
      <div class="brief-builder"><h2>A few details to get started.</h2><p class="brief-explanation">This stays in your browser. It prepares a draft in your email app; nothing is sent by this website.</p>
        <form data-project-brief hidden>
          <div class="brief-field"><label for="project-name">Project name <span>(optional)</span></label><input id="project-name" name="name" type="text" maxlength="120" autocomplete="off" /></div>
          <div class="brief-field"><label for="project-type">What do you need?</label><select id="project-type" name="type"><option>Game development</option><option>Mods &amp; extensions</option><option>Existing-project support</option><option>Help defining the project</option></select></div>
          <div class="brief-field"><label for="project-scope">The idea and the help you need</label><textarea id="project-scope" name="scope" rows="5" maxlength="4000" required placeholder="What should it do? What exists already?"></textarea></div>
          <div class="brief-field"><label for="project-platforms">Platforms or technology <span>(if known)</span></label><input id="project-platforms" name="platforms" type="text" maxlength="200" placeholder="For example: Android, Unity, Minecraft" /></div>
          <div class="brief-pair"><div class="brief-field"><label for="project-timing">Timing <span>(optional)</span></label><input id="project-timing" name="timing" type="text" maxlength="120" placeholder="A target date, or flexible" /></div><div class="brief-field"><label for="project-budget">Budget range <span>(optional)</span></label><input id="project-budget" name="budget" type="text" maxlength="120" placeholder="A range, or to be discussed" /></div></div>
          <button class="service-button" type="submit">Prepare email draft</button>
          <div class="draft-result" hidden><p data-brief-status role="status" aria-live="polite"></p><a class="service-text-link" data-brief-email href="mailto:stormeckhart@simplyshapedgames.fr">Open email draft</a></div>
        </form>
        <noscript><p>The brief builder needs JavaScript. You can email the details directly using the address on this page.</p></noscript>
      </div>
    </div>
  </div>
</SiteLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-project-brief]');
  if (form) {
    form.hidden = false;
    form.addEventListener('submit', event => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const value = (id: string) => (form.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('#' + id)?.value || '').trim();
      const name = value('project-name');
      const body = ['Hello Storm,', '', 'I would like to discuss a project.', '', 'Project: ' + (name || 'To be defined'), 'Type: ' + value('project-type'), '', value('project-scope'), '', 'Platforms / technology: ' + (value('project-platforms') || 'To be discussed'), 'Timing: ' + (value('project-timing') || 'Flexible / to be discussed'), 'Budget: ' + (value('project-budget') || 'To be discussed')].join('\n');
      const mail = form.querySelector<HTMLAnchorElement>('[data-brief-email]')!;
      mail.href = 'mailto:stormeckhart@simplyshapedgames.fr?subject=' + encodeURIComponent(name ? 'Project enquiry: ' + name : 'Game or mod project enquiry') + '&body=' + encodeURIComponent(body);
      form.querySelector<HTMLElement>('[data-brief-status]')!.textContent = 'Your draft is ready. Open it in your email app, review it and send it there. No message has been sent.';
      form.querySelector<HTMLElement>('.draft-result')!.hidden = false;
    });
  }
</script>
