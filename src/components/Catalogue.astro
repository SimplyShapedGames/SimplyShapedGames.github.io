---
import { allProjects, type Category } from '../lib/catalogue';
import { projectArtwork } from '../lib/art';
import SquarePreview from './SquarePreview.astro';
import Arrow from './Arrow.astro';
interface Props { category?: Category; standalone?: boolean; }
const { category = 'all', standalone = false } = Astro.props;
const projects = (await allProjects()).filter(p => category === 'all' || p.data.category === category);
const games = projects.filter(p => p.data.category === 'games');
const mods = projects.filter(p => p.data.category === 'mods');
const heading = category === 'games' ? 'Games to play.' : category === 'mods' ? 'Worlds to change.' : 'Games to play. Worlds to change.';
const Heading = standalone ? 'h1' : 'h2';
---
<section class:list={['work-section', 'service-container', { 'standalone-work': standalone }]} id="games-mods" aria-labelledby="work-title" data-work-catalogue>
  <Heading id="work-title">{heading}</Heading>
  {category === 'all' ? <>
    <div class="work-filters" role="group" aria-label="Filter games and mods" hidden>
      <button type="button" data-work-filter="all" aria-pressed="true">All</button>
      <button type="button" data-work-filter="games" aria-pressed="false">Games</button>
      <button type="button" data-work-filter="mods" aria-pressed="false">Mods</button>
    </div>
    <noscript><nav class="work-filters" aria-label="Games and mods"><a href="/#games-mods" aria-current="page">All</a><a href="/games/">Games</a><a href="/mods/">Mods</a></nav></noscript>
  </> : <nav class="work-filters" aria-label="Games and mods"><a href="/#games-mods">All</a><a href="/games/" aria-current={category === 'games' ? 'page' : undefined}>Games</a><a href="/mods/" aria-current={category === 'mods' ? 'page' : undefined}>Mods</a></nav>}
  <p class="visually-hidden" data-work-count role="status" aria-live="polite">{projects.length} projects shown</p>
  {games.length > 0 && <div class="work-games" data-work-group="games">{games.map(project => {
    const art = projectArtwork(project.data, 1);
    if (!art || art.width !== art.height) throw new Error(`${project.id} needs a square catalogue icon`);
    return <a class="work-game" href={`/projects/${project.id}/`} data-work-item="games">
      <div class="work-game-art"><SquarePreview src={art} alt={`${project.data.title} icon`} sizes="(max-width: 640px) 88vw, (max-width: 900px) 42vw, 28vw" /></div>
      <div class="work-card-title"><h3>{project.data.title}</h3><Arrow /></div><p>Android game</p>
    </a>;
  })}</div>}
  {mods.length > 0 && <div class="work-mods" data-work-group="mods">{mods.map(project => {
    const art = projectArtwork(project.data, 1);
    if (!art || art.width !== art.height) throw new Error(`${project.id} needs a square catalogue icon`);
    return <a class="work-mod" href={`/projects/${project.id}/`} data-work-item="mods">
      <div class="work-mod-art"><SquarePreview src={art} alt={`${project.data.title} icon`} widths={[160, 320]} sizes="(max-width: 640px) 64px, 88px" /></div>
      <div><h3>{project.data.title}</h3><p>{project.id === 'copycat-expansion' ? 'Minecraft mod' : 'Left 4 Dead 2 sound mod'}</p></div><Arrow />
    </a>;
  })}</div>}
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-work-catalogue]').forEach(catalogue => {
    const controls = catalogue.querySelector<HTMLElement>('.work-filters[hidden]');
    if (!controls) return;
    const buttons = [...controls.querySelectorAll<HTMLButtonElement>('[data-work-filter]')];
    const entries = [...catalogue.querySelectorAll<HTMLElement>('[data-work-item]')];
    const groups = [...catalogue.querySelectorAll<HTMLElement>('[data-work-group]')];
    const status = catalogue.querySelector<HTMLElement>('[data-work-count]');
    controls.hidden = false;
    buttons.forEach(button => button.addEventListener('click', () => {
      const filter = button.dataset.workFilter;
      let count = 0;
      entries.forEach(entry => { entry.hidden = filter !== 'all' && entry.dataset.workItem !== filter; if (!entry.hidden) count++; });
      groups.forEach(group => { group.hidden = filter !== 'all' && group.dataset.workGroup !== filter; });
      buttons.forEach(control => control.setAttribute('aria-pressed', String(control === button)));
      if (status) status.textContent = `${count} ${count === 1 ? 'project' : 'projects'} shown`;
    }));
  });
</script>
