---
import { allProjects, allPosts, categories, postUrl, postDate, formatDate, type Category } from '../lib/catalogue';
import ProjectCard from './ProjectCard.astro';
import ProjectRow from './ProjectRow.astro';
import CollectionCard from './CollectionCard.astro';
interface Props { category?: Category; }
const { category = 'all' } = Astro.props;
const projects = await allProjects();
const selected = projects.filter(p => category === 'all' || p.data.category === category);
const featured = selected.filter(p => p.data.featured);
const remaining = selected.filter(p => !p.data.featured);
const groups = [
  { title: 'More games', items: remaining.filter(p => p.data.category === 'games' && p.data.status !== 'In development') },
  { title: 'Game mods', items: remaining.filter(p => p.data.category === 'mods' && p.data.status !== 'In development') },
  { title: 'Web work', items: remaining.filter(p => p.data.category === 'websites') },
  { title: 'Beyond the screen', items: remaining.filter(p => p.data.category === 'design') },
].filter(group => group.items.length);
const titles = { all: 'Creations', games: 'Games', mods: 'Mods', websites: 'Websites', design: 'Design' };
const descriptions = {
  all: 'Games, mods, websites and a few things in between.',
  games: 'Small ideas. Whole worlds of play.',
  mods: 'New ways to play familiar worlds.',
  websites: 'Websites, from the first layout to the finishing details.',
  design: 'A little creativity beyond the screen.',
};
const posts = category === 'all' ? (await allPosts()).slice(0, 3) : [];
---
<section class="catalogue-shell" aria-labelledby="creations-title">
  <div class="catalogue-intro">
    <p class="eyebrow">The SimplyShapedGames collection</p>
    <div class="title-shapes"><span class="shape-circle" aria-hidden="true"></span><span class="shape-square" aria-hidden="true"></span><h1 id="creations-title">{titles[category]}<span>.</span></h1></div>
    <p class="intro-copy">{descriptions[category]}<br/><span class="quiet">A collection that keeps taking shape.</span></p>
    <nav class="category-nav" aria-label="Creation categories">
      {categories.map(item => <a href={item.href} aria-current={category === item.id ? 'page' : undefined}>{item.title}<sup>{item.id === 'all' ? projects.length : projects.filter(p => p.data.category === item.id).length}</sup></a>)}
    </nav>
    <div class="intro-note"><span class="little-spark" aria-hidden="true">✳</span><p>Made independently.<br/>Made to be explored.</p></div>
  </div>
  <div class="catalogue-content">
    {featured.length > 0 && <div class="project-grid" aria-label="Published games">{featured.map((project, index) => <ProjectCard project={project} index={index} />)}</div>}
    {groups.map(group => <section class="catalogue-group" aria-label={group.title}>
      <div class="browse-more"><h2>{group.title}</h2><span class="short-rule"></span><span class="group-count">{String(group.items.length).padStart(2,'0')}</span></div>
      {category === 'all' ? group.items.map(project => <ProjectRow project={project} />) : <div class="collection-grid">{group.items.map(project => <CollectionCard project={project} />)}</div>}
    </section>)}
    {posts.length > 0 && <section class="journal-peek" aria-labelledby="journal-peek-title">
      <div class="section-heading"><h2 id="journal-peek-title">From the journal<span>.</span></h2><a class="text-link" href="/journal/">All posts <span aria-hidden="true">↗</span></a></div>
      {posts.map(post => <a class="journal-line" href={postUrl(post.id)}><time datetime={postDate(post.id).toISOString()}>{formatDate(postDate(post.id))}</time><span>{post.data.title}</span><span aria-hidden="true">↗</span></a>)}
    </section>}
  </div>
</section>
