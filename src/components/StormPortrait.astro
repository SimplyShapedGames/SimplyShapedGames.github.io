---
interface Props { accent?: string; }
const { accent = 'var(--ink)' } = Astro.props;
---
<figure class="storm-portrait" style={`--portrait-accent: ${accent}`}>
  <div class="portrait-frame">
    <img
      src="/portraits/storm-eckhart-smiling-2026-640.webp"
      srcset="/portraits/storm-eckhart-smiling-2026-320.webp 320w, /portraits/storm-eckhart-smiling-2026-640.webp 640w"
      sizes="(max-width: 370px) 84vw, 320px"
      width="640"
      height="640"
      alt="Storm Eckhart smiling outdoors, March 2026"
      loading="eager"
      decoding="async"
    />
  </div>
  <figcaption>Storm Eckhart</figcaption>
</figure>
<style>
  .storm-portrait { width: 320px; max-width: 100%; margin: 0 0 2rem; }
  .portrait-frame {
    padding: 10px;
    background: var(--portrait-accent);
    border-radius: 46% 54% 44% 56% / 52% 43% 57% 48%;
  }
  .portrait-frame img { display: block; width: 100%; height: auto; aspect-ratio: 1; border-radius: inherit; }
  figcaption { margin-top: .75rem; color: var(--muted); font-size: .875rem; }
</style>
