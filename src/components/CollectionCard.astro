---
import SquarePreview from './SquarePreview.astro';
import type { CollectionEntry } from 'astro:content';
import { projectArtwork } from '../lib/art';
interface Props { project: CollectionEntry<'projects'>; }
const { project: { data, id } } = Astro.props;
const art = projectArtwork(data, 1);
---
<article class:list={['collection-card', `collection-${id}`]}>
  <a href={`/projects/${id}/`}>
    <div class="collection-art">
      {art ? <SquarePreview src={art} alt={`${data.title} — ${art.width / art.height > 3 ? 'artwork detail' : 'project preview'}`} widths={[400, 700, 1000]} sizes="(max-width: 560px) 90vw, (max-width: 1200px) 45vw, 30vw" /> : <div class="collection-type" aria-hidden="true"><span>{data.title}</span><span class="tiny-shapes"><i></i><i></i><i></i></span></div>}
      <span class="collection-open" aria-hidden="true">↗</span>
    </div>
    <div class="collection-caption"><p class="collection-status"><span class:list={['status-dot', { 'is-development': data.status === 'In development' }]}></span>{data.status}{data.platforms.length ? ` · ${data.platforms.join(' / ')}` : ''}</p><h3>{data.title}</h3><p>{data.summary}</p></div>
  </a>
</article>
