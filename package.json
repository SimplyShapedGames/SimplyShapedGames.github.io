{
  "name": "simplyshapedgames-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "verify:preview": "node scripts/verify-preview.mjs",
    "check": "astro check",
    "test": "node --test scripts/test-interactions.mjs scripts/test-preview.mjs"
  },
  "dependencies": {
    "astro": "7.3.1",
    "sharp": "0.35.4",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "typescript": "^5.9.0"
  },
  "engines": { "node": ">=24.0.0" }
}
