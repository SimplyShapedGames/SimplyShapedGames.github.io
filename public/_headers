# Static Cloudflare Pages headers, matching the SSS public artifact.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Project-neutral patterns also cover hashed and branch preview addresses.
# These rules do not match simplyshapedgames.fr; the custom domain stays indexable.
https://:project.pages.dev/*
  X-Robots-Tag: noindex, follow

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, follow

/404.html
  X-Robots-Tag: noindex, follow

/404
  X-Robots-Tag: noindex, follow
